# Copy to .env.local (never commit real secrets). All variables are optional.

# EmailJS (contact form). Defaults in src/pages/Contact.tsx are the current account values.
# The EmailJS public key is meant to be public; protect the account with "Allowed origins".
VITE_EMAILJS_SERVICE_ID=service_srq3qjb
VITE_EMAILJS_TEMPLATE_ID=template_ivo607f
VITE_EMAILJS_PUBLIC_KEY=pd47JUs1ZBhhOIIan

# Timetable from a Google Sheet: File → Share → Publish to web → (sheet) → CSV → copy link.
# Leave empty to use src/content/timetable.ts only.
VITE_TIMETABLE_SHEET_CSV=
